# M4-Cloud
M4_HTTP_BIND=0.0.0.0
M4_HTTP_PORT=8080

POSTGRES_DB=m4cloud
POSTGRES_USER=m4cloud
POSTGRES_PASSWORD=CHANGE_ME

# Safe default: localhost only. Configure auth/TLS before LAN exposure.
M4_MQTT_BIND=127.0.0.1
M4_MQTT_PORT=1883
MQTT_HOST=mqtt
MQTT_PORT=1883

# Licensed/official DJI FH2 On-Premises upstream (optional)
FH2_UPSTREAM_BASE_URL=
FH2_UPSTREAM_VERIFY_TLS=true
