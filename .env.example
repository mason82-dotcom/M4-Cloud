M4_ENV=development
M4_BIND=0.0.0.0
M4_HOST=0.0.0.0
M4_PORT=8080

POSTGRES_DB=m4
POSTGRES_USER=m4
POSTGRES_PASSWORD=change-me

# Interner M4-Servicezugang zum Broker
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_SERVICE_USERNAME=m4-service
MQTT_SERVICE_PASSWORD=change-me-mqtt

# Externer Broker-Endpunkt. Standard bleibt Loopback, bis der Direktor
# RC-Pro-/Pilot-2-LAN-Zugriff und den TLS-Pfad freigibt.
MQTT_BIND=127.0.0.1
MQTT_PUBLIC_HOST=127.0.0.1
MQTT_PUBLIC_PORT=1883
DJI_MQTT_USERNAME=dji-client
DJI_MQTT_PASSWORD=change-me-dji-mqtt
MQTT_PUBLIC_TLS=false

# Optionaler externer TLS-Listener (nur mit docker-compose.tls.yml)
MQTT_TLS_BIND=0.0.0.0
MQTT_TLS_PORT=8883
MQTT_TLS_CERT_FILE=./secrets/mqtt-tls/server.crt
MQTT_TLS_KEY_FILE=./secrets/mqtt-tls/server.key

# FlightHub 2 Privatization / On-Premises OpenAPI V2
FH2_ENABLED=false
FH2_BASE_URL=
FH2_ORG_ID=
FH2_PROJECT_ID=
FH2_USER_TOKEN=
FH2_VERIFY_TLS=true
FH2_TIMEOUT_SECONDS=15

# DJI Cloud API HTTP-Pfad für read-only Kamera-Capacity
DJI_CLOUD_API_ENABLED=false
DJI_CLOUD_API_BASE_URL=
DJI_CLOUD_API_ACCESS_TOKEN=
DJI_CLOUD_API_VERIFY_TLS=true
DJI_CLOUD_API_TIMEOUT_SECONDS=15
