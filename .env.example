# M4-Cloud HTTP entrypoint
M4_HTTP_BIND=0.0.0.0
M4_HTTP_PORT=8080

# PostgreSQL
POSTGRES_DB=m4cloud
POSTGRES_USER=m4cloud
POSTGRES_PASSWORD=CHANGE_ME

# MQTT
# Safe default: host loopback only. Keep this value unless authenticated/TLS
# MQTT access from the LAN is explicitly required.
M4_MQTT_BIND=127.0.0.1
M4_MQTT_PORT=1883
MQTT_HOST=mqtt
MQTT_PORT=1883
DJI_MQTT_TOPICS=m4/fh2/#

# Licensed/official DJI FlightHub 2 On-Premises / Privatization OpenAPI V2
# Server root including scheme and port, without /openapi/... suffix.
FH2_UPSTREAM_BASE_URL=

# Organization-scoped OpenAPI key. Sent as X-User-Token.
# Never commit a real token.
FH2_USER_TOKEN=

# Organization UUID used by manage-devices and HMS endpoints.
FH2_ORG_UUID=

# Project/workspace UUID used by wayline and flight-task endpoints.
FH2_PROJECT_UUID=

# DJI supports zh/en headers. The official Privatization HMS demo uses zh.
FH2_LANGUAGE=zh

FH2_UPSTREAM_VERIFY_TLS=true
FH2_TIMEOUT_SECONDS=15

# Migration note:
# M4 V1.0 used FH2_API_TOKEN. The application still reads it as a fallback,
# but new installations should use FH2_USER_TOKEN.


# DJI Cloud API / Pilot2 camera discovery (read-only)
# Root URL of the Cloud API backend, e.g. https://cloud.example.local
DJI_CLOUD_API_BASE_URL=

# Access token used by DJI's official demo in the x-auth-token header.
# Initially this can be copied from the login/bootstrap response.
DJI_CLOUD_API_TOKEN=

DJI_CLOUD_API_VERIFY_TLS=true
DJI_CLOUD_API_TIMEOUT_SECONDS=15

# Optional monitoring profile
PROMETHEUS_PORT=9090
