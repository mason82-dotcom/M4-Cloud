# M4-Cloud HTTP entrypoint
M4_HTTP_BIND=0.0.0.0
M4_HTTP_PORT=8080

# PostgreSQL
POSTGRES_DB=m4cloud
POSTGRES_USER=m4cloud
POSTGRES_PASSWORD=CHANGE_ME

# MQTT
# Safe default: host loopback only. Keep this value unless authenticated/TLS
# MQTT access from the LAN is explicitly required.
M4_MQTT_BIND=127.0.0.1
M4_MQTT_PORT=1883
MQTT_HOST=mqtt
MQTT_PORT=1883
DJI_MQTT_TOPICS=m4/fh2/#

# DJI Cloud API - Phase 1: MQTT ingest only.
# Keep disabled until the M4 broker/authentication and Pilot 2 bootstrap are configured.
DJI_CLOUD_API_ENABLED=false
DJI_CLOUD_API_TOPICS=thing/product/+/osd,thing/product/+/state,thing/product/+/services_reply,thing/product/+/events,thing/product/+/requests,thing/product/+/property/set_reply,thing/product/+/drc/up,sys/product/+/status

# Licensed/official DJI FlightHub 2 On-Premises upstream
# Keep empty until an actual DJI FH2 server/AIO and its OpenAPI access exist.
FH2_UPSTREAM_BASE_URL=
FH2_API_TOKEN=
FH2_UPSTREAM_VERIFY_TLS=true

# Optional monitoring profile
PROMETHEUS_PORT=9090
