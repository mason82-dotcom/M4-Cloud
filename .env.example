# M4-Cloud HTTP entrypoint
M4_HTTP_BIND=0.0.0.0
M4_HTTP_PORT=8080

# PostgreSQL
POSTGRES_DB=m4cloud
POSTGRES_USER=m4cloud
POSTGRES_PASSWORD=CHANGE_ME

# MQTT - internal identities
M4_MQTT_BIND=127.0.0.1
M4_MQTT_PORT=1883
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_WORKER_USERNAME=m4-worker
MQTT_WORKER_PASSWORD=CHANGE_ME
MQTT_HEALTH_USERNAME=m4-health
MQTT_HEALTH_PASSWORD=CHANGE_ME
DJI_MQTT_TOPICS=m4/fh2/#

# DJI Cloud API
DJI_CLOUD_API_ENABLED=false
DJI_CLOUD_API_TOPICS=thing/product/+/osd,thing/product/+/state,thing/product/+/services_reply,thing/product/+/events,thing/product/+/requests,thing/product/+/property/set_reply,thing/product/+/drc/up,sys/product/+/status

# M4-owned protection for the bootstrap endpoint
DJI_BOOTSTRAP_TOKEN=CHANGE_ME

# Pilot 2 platform/workspace
DJI_PLATFORM_NAME=M4 Cloud
DJI_WORKSPACE_ID=CHANGE_ME
DJI_WORKSPACE_NAME=M4 Workspace
DJI_WORKSPACE_DESCRIPTION=M4 DJI Cloud

# DJI developer credentials - request from DJI Developer
DJI_APP_ID=
DJI_APP_KEY=
DJI_APP_LICENSE=

# Pilot 2 API/WebSocket module configuration
# Set these only when M4 is reachable from the RC Pro/Dock.
DJI_API_HOST=
DJI_API_TOKEN=CHANGE_ME
DJI_WS_HOST=
DJI_WS_TOKEN=CHANGE_ME

# Pilot 2 MQTT module configuration.
# Keep the host empty until external TLS/LAN access is deliberately enabled.
DJI_MQTT_EXTERNAL_HOST=
DJI_MQTT_USERNAME=dji-pilot
DJI_MQTT_PASSWORD=CHANGE_ME

# Licensed/official DJI FlightHub 2 On-Premises upstream
FH2_UPSTREAM_BASE_URL=
FH2_API_TOKEN=
FH2_UPSTREAM_VERIFY_TLS=true

# Optional monitoring profile
PROMETHEUS_PORT=9090
