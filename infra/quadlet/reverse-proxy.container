[Unit]
Description=M4-Cloud reverse proxy
Requires=control-api.container
After=control-api.container
PartOf=m4-cloud.target

[Container]
Image=docker.io/library/nginx:1.27-alpine
ContainerName=m4-reverse-proxy
Network=m4.network
NetworkAlias=reverse-proxy
PublishPort=0.0.0.0:8080:80
Volume=%h/.config/m4-cloud/assets/nginx.conf:/etc/nginx/conf.d/default.conf:ro
HealthCmd=wget -q -O - http://127.0.0.1/health >/dev/null || exit 1
HealthInterval=10s
HealthTimeout=3s
HealthRetries=5
HealthOnFailure=kill
Notify=healthy

[Service]
Restart=on-failure
TimeoutStartSec=180
