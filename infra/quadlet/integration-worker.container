[Unit]
Description=M4-Cloud MQTT integration worker
Requires=postgres.container mqtt.container
After=postgres.container mqtt.container
PartOf=m4-cloud.target

[Container]
Image=localhost/m4-control-api:current
Pull=never
ContainerName=m4-integration-worker
EnvironmentFile=%h/.config/m4-cloud/m4.env
Environment=POSTGRES_HOST=postgres
Environment=POSTGRES_PORT=5432
Environment=MQTT_HOST=mqtt
Environment=MQTT_PORT=1883
Network=m4.network
Exec=python -m app.mqtt_worker

[Service]
Restart=on-failure
TimeoutStartSec=180
