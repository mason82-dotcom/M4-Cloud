[Unit]
Description=M4-Cloud Control API
Requires=postgres.container mqtt.container
After=postgres.container mqtt.container
PartOf=m4-cloud.target

[Container]
Image=localhost/m4-control-api:current
Pull=never
ContainerName=m4-control-api
EnvironmentFile=%h/.config/m4-cloud/m4.env
Environment=POSTGRES_HOST=postgres
Environment=POSTGRES_PORT=5432
Environment=MQTT_HOST=mqtt
Environment=MQTT_PORT=1883
Network=m4.network
NetworkAlias=control-api
HealthCmd=python -c 'import urllib.request; urllib.request.urlopen("http://127.0.0.1:8000/health", timeout=2)'
HealthInterval=10s
HealthTimeout=3s
HealthRetries=5
HealthStartPeriod=10s
HealthOnFailure=kill
Notify=healthy

[Service]
Restart=on-failure
TimeoutStartSec=180
