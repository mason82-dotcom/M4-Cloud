[Unit]
Description=M4-Cloud MQTT broker
PartOf=m4-cloud.target

[Container]
Image=localhost/m4-mqtt:current
Pull=never
ContainerName=m4-mqtt
EnvironmentFile=%h/.config/m4-cloud/m4.env
Network=m4.network
NetworkAlias=mqtt
PublishPort=127.0.0.1:1883:1883
Volume=mqtt-data.volume:/mosquitto/data
HealthCmd=sh -c 'mosquitto_pub -h 127.0.0.1 -p 1883 -u "$MQTT_HEALTH_USERNAME" -P "$MQTT_HEALTH_PASSWORD" -t m4/health -m ping >/dev/null 2>&1'
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=5s
HealthOnFailure=kill
Notify=healthy

[Service]
Restart=on-failure
TimeoutStartSec=180
