[Unit]
Description=M4-Cloud MQTT broker
PartOf=m4-cloud.target

[Container]
Image=docker.io/library/eclipse-mosquitto:2
ContainerName=m4-mqtt
Network=m4.network
NetworkAlias=mqtt
PublishPort=127.0.0.1:1883:1883
Volume=mqtt-data.volume:/mosquitto/data
Volume=%h/.config/m4-cloud/assets/mosquitto.conf:/mosquitto/config/mosquitto.conf:ro
HealthCmd=mosquitto_pub -h 127.0.0.1 -p 1883 -t m4/health -m ping >/dev/null 2>&1
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=5s
HealthOnFailure=kill
Notify=healthy

[Service]
Restart=on-failure
TimeoutStartSec=180
